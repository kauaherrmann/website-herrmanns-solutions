# Variáveis do frontend (Vite)
# Copie para ".env" ou ".env.local" e ajuste as URLs conforme o ambiente.

# Se for usar o API Gateway/BFF
VITE_PUBLIC_BFF_URL=http://localhost:5100

# Acesso direto às APIs (dev)
VITE_CATALOG_API_URL=http://localhost:5101/api/v1
VITE_IDENTITY_API_URL=http://localhost:5102/api/v1

# Opção genérica: uma base única usada hoje no front (ex.: apontando para o Catalog)
VITE_API_BASE_URL=http://localhost:5101/api/v1
